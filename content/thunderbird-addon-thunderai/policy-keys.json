    {
        "key": "_disable_prompt_management",
        "type": "boolean",
        "default": "false",
        "group": "Restrictions",
        "category": "structural",
        "settable": true,
        "values": "true",
        "notes": "No prompt can be created, duplicated, imported or exported. The user's own prompts become read-only and are removed from the menus, but are never deleted. Built-in and organization prompts keep working. See <a href=\"#restrictions\">Restrictions</a>.",
        "version": "5.1.0"
    },
    {
        "key": "_disable_default_prompts",
        "type": "boolean",
        "default": "false",
        "group": "Restrictions",
        "category": "structural",
        "settable": true,
        "values": "true",
        "notes": "Removes the ThunderAI built-in prompts from the menus, typically leaving only the organization ones. Special features (tags, summarize, translate, spam filter, calendar, task) are not affected. See <a href=\"#restrictions\">Restrictions</a>.",
        "version": "5.1.0"
    },
    {
